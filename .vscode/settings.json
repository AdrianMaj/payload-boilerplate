{
  "npm.packageManager": "pnpm",

  // Prettier dla wszystkiego, co nie ma wlasnego nadpisania nizej
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",

  // TS/JS dodatkowo dostaja autofix ESLinta przy zapisie
  "[typescript][typescriptreact][javascript][javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[json][jsonc][css][scss][markdown][yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // uzywaj TypeScripta z repo, nie tego wbudowanego w edytor
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,

  // Tailwind v4 nie ma tailwind.config.ts - IntelliSense czyta motyw z pliku CSS
  "tailwindCSS.experimental.configFile": "src/app/(frontend)/globals.css",
  // podpowiedzi klas rowniez wewnatrz cn() i cva() uzywanych przez shadcn
  "tailwindCSS.classFunctions": ["cn", "cva", "clsx", "twMerge"],
  "editor.quickSuggestions": {
    "strings": "on"
  }
}
